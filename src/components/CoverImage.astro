---
// A performance cover with its date as a highlighted badge along the bottom.
interface Props {
	src: string;
	alt?: string;
	date?: string | null;
	long?: boolean; // "October 12, 2026" instead of "Oct 12, 2026"
	class?: string;
}
const { src, alt = "", date, long = false, class: className } = Astro.props;

// event_date is a plain YYYY-MM-DD, so format in UTC to avoid shifting a day.
const label = date
	? new Date(date).toLocaleDateString("en-US", {
			month: long ? "long" : "short",
			day: "numeric",
			year: "numeric",
			timeZone: "UTC",
		})
	: null;
---

<div class="cover-wrap">
	<img class={className} src={src} alt={alt} />
	{label && <span class="cover-date">{label}</span>}
</div>

<style>
	.cover-wrap {
		position: relative;
	}
	.cover-wrap img {
		display: block;
	}
	.cover-date {
		position: absolute;
		right: 0.75em;
		bottom: 0.75em;
		padding: 0.3em 0.85em;
		border-radius: 999px;
		background: var(--accent-dark);
		color: var(--cream);
		border: 1px solid var(--gold);
		font-size: 0.85em;
		font-weight: 700;
		letter-spacing: 0.01em;
		box-shadow: 0 2px 10px rgba(27, 33, 48, 0.35);
		pointer-events: none;
	}
</style>
