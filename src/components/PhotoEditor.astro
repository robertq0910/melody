---
// Edit-before-upload for admin image inputs: (1) crop, (2) cover senior
// residents' faces with cartoon stickers (privacy policy). Add `data-crop` to
// any <input type="file"> to enable it; the value is the default crop shape
// ("3/2", "1/1", "free", ...). Add `data-no-faces` to skip step 2 (e.g. for
// performer headshots, who aren't residents). Add `data-autosubmit` to submit the
// input's form as soon as editing finishes. Everything happens in the browser and the
// stickers are painted into the pixels, so the uploaded file never contains
// the original faces. Server code is unchanged.
---

<dialog class="photo-editor" aria-label="Edit photo">
	<div class="pe-head">
		<strong class="pe-title"></strong>
		<span class="pe-count muted"></span>
	</div>

	<section class="pe-pane" data-pane="crop">
		<div class="pe-stage">
			<img class="pe-crop-img" alt="" />
		</div>
		<div class="pe-tools" role="toolbar" aria-label="Crop options">
			<div class="pe-group" role="group" aria-label="Shape">
				<button type="button" class="pe-tool" data-ratio="3/2">3:2</button>
				<button type="button" class="pe-tool" data-ratio="4/3">4:3</button>
				<button type="button" class="pe-tool" data-ratio="1/1">Square</button>
				<button type="button" class="pe-tool" data-ratio="free">Free</button>
			</div>
			<div class="pe-group" role="group" aria-label="Rotate">
				<button type="button" class="pe-tool" data-rotate="-90" aria-label="Rotate left">⟲</button>
				<button type="button" class="pe-tool" data-rotate="90" aria-label="Rotate right">⟳</button>
			</div>
		</div>
		<div class="pe-actions">
			<button type="button" class="btn btn-secondary pe-cancel">Cancel</button>
			<button type="button" class="btn btn-secondary pe-whole">Use whole photo</button>
			<button type="button" class="btn btn-primary pe-next">Crop &amp; continue</button>
		</div>
	</section>

	<section class="pe-pane" data-pane="faces" hidden>
		<p class="pe-hint">
			<strong>Senior residents' faces must be covered.</strong> Tap a face to add a sticker, drag a
			sticker to move it, drag its corner dot to resize. Remove stickers from anyone who doesn't need
			covering.
		</p>
		<p class="pe-status" role="status"></p>
		<div class="pe-stage pe-face-stage">
			<div class="pe-frame">
				<img class="pe-face-img" alt="" draggable="false" />
				<div class="pe-layer"></div>
			</div>
		</div>
		<div class="pe-tools" role="toolbar" aria-label="Sticker options">
			<div class="pe-group pe-styles" role="group" aria-label="Sticker style"></div>
			<div class="pe-group">
				<button type="button" class="pe-tool pe-detect">Find faces</button>
				<button type="button" class="pe-tool pe-remove" disabled>Remove sticker</button>
				<button type="button" class="pe-tool pe-remove-all" disabled>Remove all</button>
			</div>
		</div>
		<div class="pe-actions">
			<button type="button" class="btn btn-secondary pe-cancel">Cancel</button>
			<button type="button" class="btn btn-primary pe-done">Use photo</button>
		</div>
	</section>
</dialog>

<style is:global>
	.photo-editor {
		width: min(960px, 100vw);
		max-width: 100vw;
		max-height: 100dvh;
		padding: 1em;
		border: none;
		border-radius: var(--radius);
		box-shadow: var(--shadow-lg);
	}
	.photo-editor::backdrop {
		background: rgba(10, 8, 20, 0.7);
	}
	.pe-pane:not([hidden]) {
		display: flex;
		flex-direction: column;
		gap: 0.8em;
	}
	.pe-head {
		display: flex;
		align-items: baseline;
		gap: 0.6em;
		margin-bottom: 0.6em;
	}
	.pe-stage {
		height: min(58dvh, 540px);
		background: rgb(var(--gray-light));
		border-radius: var(--radius-sm);
		overflow: hidden;
	}
	.pe-crop-img {
		display: block;
		max-width: 100%;
	}
	.pe-face-stage {
		display: flex;
		align-items: center;
		justify-content: center;
	}
	.pe-frame {
		position: relative;
		touch-action: none;
		user-select: none;
		-webkit-user-select: none;
		cursor: crosshair;
	}
	.pe-face-img {
		display: block;
		max-width: 100%;
		max-height: min(58dvh, 540px);
	}
	.pe-layer {
		position: absolute;
		inset: 0;
	}
	.pe-sticker {
		position: absolute;
		aspect-ratio: 1;
		transform: translate(-50%, -50%);
		cursor: move;
		touch-action: none;
	}
	.pe-sticker img {
		display: block;
		width: 100%;
		height: 100%;
		pointer-events: none;
	}
	.pe-sticker.selected {
		outline: 3px dashed var(--accent);
		outline-offset: 2px;
		border-radius: 50%;
	}
	.pe-handle {
		display: none;
		position: absolute;
		right: -14px;
		bottom: -14px;
		width: 28px;
		height: 28px;
		border-radius: 50%;
		background: var(--accent);
		border: 3px solid white;
		cursor: nwse-resize;
		touch-action: none;
	}
	/* Bigger invisible hit area for fingers. */
	.pe-handle::after {
		content: "";
		position: absolute;
		inset: -10px;
	}
	.pe-sticker.selected .pe-handle {
		display: block;
	}
	.pe-hint {
		margin: 0;
		font-size: 0.95em;
	}
	.pe-status {
		margin: 0;
		font-weight: 700;
		color: var(--accent);
		min-height: 1.4em;
	}
	.pe-tools {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 0.6em;
	}
	.pe-group {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4em;
	}
	.pe-tool {
		min-width: 48px;
		min-height: 48px;
		padding: 0 0.9em;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 999px;
		background: var(--surface);
		color: rgb(var(--black));
		font: inherit;
		font-weight: 700;
		cursor: pointer;
	}
	.pe-tool:disabled {
		opacity: 0.45;
		cursor: default;
	}
	.pe-tool[aria-pressed="true"] {
		background: var(--accent);
		border-color: var(--accent);
		color: white;
	}
	.pe-styles .pe-tool {
		padding: 4px;
		width: 52px;
		height: 52px;
	}
	.pe-styles img {
		width: 100%;
		height: 100%;
		display: block;
	}
	.pe-actions {
		display: flex;
		flex-wrap: wrap;
		justify-content: flex-end;
		gap: 0.6em;
	}
	.pe-actions .pe-cancel {
		margin-right: auto;
	}
	.crop-previews {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4em;
		margin-top: 0.4em;
	}
	.crop-previews img {
		height: 64px;
		border-radius: 6px;
		box-shadow: var(--shadow-sm);
	}
</style>

<script>
	import Cropper from "cropperjs";
	import "cropperjs/dist/cropper.css";
	import { STICKERS, stickerUrl, loadSticker } from "../scripts/senior-stickers";
	import { detectFaces } from "../scripts/face-detect";

	const dialog = document.querySelector<HTMLDialogElement>(".photo-editor")!;
	const $ = <T extends HTMLElement>(sel: string) => dialog.querySelector<T>(sel)!;
	const title = $(".pe-title");
	const count = $(".pe-count");
	const cropPane = $('[data-pane="crop"]');
	const facePane = $('[data-pane="faces"]');
	const cropImg = $<HTMLImageElement>(".pe-crop-img");
	const faceImg = $<HTMLImageElement>(".pe-face-img");
	const frame = $(".pe-frame");
	const layer = $(".pe-layer");
	const status = $(".pe-status");
	const styles = $(".pe-styles");
	const detectBtn = $<HTMLButtonElement>(".pe-detect");
	const removeBtn = $<HTMLButtonElement>(".pe-remove");
	const removeAllBtn = $<HTMLButtonElement>(".pe-remove-all");
	const ratioButtons = Array.from(dialog.querySelectorAll<HTMLButtonElement>("[data-ratio]"));

	// Formats we can read and re-encode. GIFs are flattened to their first frame
	// so their faces get covered too.
	const EDITABLE = ["image/jpeg", "image/png", "image/webp", "image/gif"];
	// Keep output well under the server's 5 MB limit.
	const MAX_SIDE = 2400;
	// Sticker size relative to the detected face box, so hair/chin are covered too.
	const FACE_PAD = 1.7;

	// ---------- shared helpers ----------

	function parseRatio(value: string | undefined): number {
		if (!value || value === "free") return NaN;
		const [w, h] = value.split("/").map(Number);
		return w > 0 && h > 0 ? w / h : NaN;
	}

	function showPane(which: "crop" | "faces", lastStep = false) {
		cropPane.hidden = which !== "crop";
		facePane.hidden = which !== "faces";
		$(".pe-next").textContent = lastStep ? "Crop" : "Crop & continue";
		title.textContent =
			which === "faces" ? "Step 2 · Cover faces" : lastStep ? "Crop photo" : "Step 1 · Crop photo";
	}

	// Each step resolves to a value, or null if the user cancelled.
	function onceCancelled(signal: AbortSignal, cancel: () => void) {
		dialog.querySelectorAll(".pe-cancel").forEach((b) => b.addEventListener("click", cancel, { signal }));
		// Esc closes the dialog; treat it like Cancel.
		dialog.addEventListener(
			"cancel",
			(e) => {
				e.preventDefault();
				cancel();
			},
			{ signal },
		);
	}

	function fitCanvas(source: CanvasImageSource, w: number, h: number): HTMLCanvasElement {
		const scale = Math.min(1, MAX_SIDE / Math.max(w, h));
		const c = document.createElement("canvas");
		c.width = Math.round(w * scale);
		c.height = Math.round(h * scale);
		c.getContext("2d")!.drawImage(source, 0, 0, c.width, c.height);
		return c;
	}

	// ---------- step 1: crop ----------

	function cropStep(file: File, defaultRatio: string, lastStep: boolean): Promise<HTMLCanvasElement | null> {
		showPane("crop", lastStep);
		return new Promise((resolve) => {
			const url = URL.createObjectURL(file);
			const ac = new AbortController();
			let cropper: Cropper | null = null;
			const on = (sel: string, fn: (el: HTMLElement) => void) =>
				dialog.querySelectorAll<HTMLElement>(sel).forEach((el) =>
					el.addEventListener("click", () => fn(el), { signal: ac.signal }),
				);
			const setRatio = (value: string) => {
				cropper?.setAspectRatio(parseRatio(value));
				ratioButtons.forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.ratio === value)));
			};
			const finish = (result: HTMLCanvasElement | null) => {
				ac.abort();
				cropper?.destroy();
				URL.revokeObjectURL(url);
				cropImg.removeAttribute("src");
				resolve(result);
			};

			cropImg.addEventListener(
				"load",
				() => {
					cropper = new Cropper(cropImg, { viewMode: 1, autoCropArea: 1, background: false });
					setRatio(defaultRatio);
				},
				{ once: true, signal: ac.signal },
			);
			cropImg.src = url;

			on("[data-ratio]", (el) => setRatio(el.dataset.ratio!));
			on("[data-rotate]", (el) => cropper?.rotate(Number(el.dataset.rotate)));
			on(".pe-whole", () => finish(fitCanvas(cropImg, cropImg.naturalWidth, cropImg.naturalHeight)));
			on(".pe-next", () => {
				if (!cropper) return;
				finish(
					cropper.getCroppedCanvas({
						maxWidth: MAX_SIDE,
						maxHeight: MAX_SIDE,
						imageSmoothingQuality: "high",
						fillColor: "#fff",
					}),
				);
			});
			onceCancelled(ac.signal, () => finish(null));
		});
	}

	// ---------- step 2: cover faces ----------

	// Center (cx, cy) as fractions of image width/height; size as a fraction of image width.
	interface Sticker {
		cx: number;
		cy: number;
		size: number;
		style: number;
		el: HTMLElement;
	}

	let currentStyle = 0;

	// Sticker style picker, built once from the sticker list.
	STICKERS.forEach((s, i) => {
		const b = document.createElement("button");
		b.type = "button";
		b.className = "pe-tool";
		b.dataset.style = String(i);
		b.setAttribute("aria-label", s.name);
		b.title = s.name;
		const im = document.createElement("img");
		im.src = stickerUrl(i);
		im.alt = "";
		b.append(im);
		styles.append(b);
	});

	function facesStep(base: HTMLCanvasElement, type: string): Promise<Blob | null> {
		showPane("faces");
		layer.replaceChildren();
		removeAllBtn.disabled = true;
		status.textContent = "";
		return new Promise((resolve) => {
			const ac = new AbortController();
			const signal = ac.signal;
			const stickers: Sticker[] = [];
			let selected: Sticker | null = null;
			let busy = false;
			let saving = false;
			const W = base.width;
			const H = base.height;

			base.toBlob((b) => {
				if (b) faceImg.src = URL.createObjectURL(b);
			}, "image/jpeg", 0.92);

			const pressStyle = () =>
				styles.querySelectorAll<HTMLElement>("[data-style]").forEach((b) =>
					b.setAttribute("aria-pressed", String(Number(b.dataset.style) === (selected?.style ?? currentStyle))),
				);

			const render = (s: Sticker) => {
				s.el.style.left = `${s.cx * 100}%`;
				s.el.style.top = `${s.cy * 100}%`;
				s.el.style.width = `${s.size * 100}%`;
				(s.el.firstElementChild as HTMLImageElement).src = stickerUrl(s.style);
			};

			const select = (s: Sticker | null) => {
				selected?.el.classList.remove("selected");
				selected = s;
				s?.el.classList.add("selected");
				removeBtn.disabled = !s;
				pressStyle();
			};

			const add = (cx: number, cy: number, size: number, style = currentStyle): Sticker => {
				const el = document.createElement("div");
				el.className = "pe-sticker";
				el.innerHTML = '<img alt="" draggable="false" /><span class="pe-handle"></span>';
				const s: Sticker = { cx, cy, size: Math.min(1, Math.max(0.02, size)), style, el };
				stickers.push(s);
				layer.append(el);
				render(s);
				removeAllBtn.disabled = false;
				return s;
			};

			const remove = (s: Sticker) => {
				s.el.remove();
				stickers.splice(stickers.indexOf(s), 1);
				if (selected === s) select(null);
				removeAllBtn.disabled = stickers.length === 0;
			};

			// Pointer handling: drag a sticker to move it, drag its handle to
			// resize, tap empty space to add a sticker there.
			let drag: { s: Sticker; mode: "move" | "resize"; dx: number; dy: number } | null = null;
			const point = (e: PointerEvent) => {
				const r = frame.getBoundingClientRect();
				return { x: (e.clientX - r.left) / r.width, y: (e.clientY - r.top) / r.height, r };
			};

			frame.addEventListener(
				"pointerdown",
				(e) => {
					const p = point(e);
					const target = e.target as HTMLElement;
					const el = target.closest<HTMLElement>(".pe-sticker");
					let s = el ? stickers.find((k) => k.el === el)! : null;
					if (!s) {
						// Default to the last sticker's size, else ~12% of the width.
						const size = selected?.size ?? stickers.at(-1)?.size ?? 0.12;
						s = add(p.x, p.y, size);
					}
					select(s);
					drag = {
						s,
						mode: target.classList.contains("pe-handle") ? "resize" : "move",
						dx: p.x - s.cx,
						dy: p.y - s.cy,
					};
					frame.setPointerCapture(e.pointerId);
					e.preventDefault();
				},
				{ signal },
			);
			frame.addEventListener(
				"pointermove",
				(e) => {
					if (!drag) return;
					const p = point(e);
					const s = drag.s;
					if (drag.mode === "move") {
						s.cx = Math.min(1, Math.max(0, p.x - drag.dx));
						s.cy = Math.min(1, Math.max(0, p.y - drag.dy));
					} else {
						// Half the sticker's side = the larger offset of the pointer from its center.
						const half = Math.max(
							Math.abs(p.x - s.cx) * p.r.width,
							Math.abs(p.y - s.cy) * p.r.height,
						);
						s.size = Math.min(1, Math.max(0.02, (2 * half) / p.r.width));
					}
					render(s);
				},
				{ signal },
			);
			const endDrag = () => (drag = null);
			frame.addEventListener("pointerup", endDrag, { signal });
			frame.addEventListener("pointercancel", endDrag, { signal });

			styles.addEventListener(
				"click",
				(e) => {
					const b = (e.target as HTMLElement).closest<HTMLElement>("[data-style]");
					if (!b) return;
					currentStyle = Number(b.dataset.style);
					if (selected) {
						selected.style = currentStyle;
						render(selected);
					}
					pressStyle();
				},
				{ signal },
			);
			removeBtn.addEventListener("click", () => selected && remove(selected), { signal });
			removeAllBtn.addEventListener(
				"click",
				() => {
					if (confirm(`Remove all ${stickers.length} stickers? Faces will be uncovered.`)) {
						[...stickers].forEach(remove);
					}
				},
				{ signal },
			);
			dialog.addEventListener(
				"keydown",
				(e) => {
					if (selected && (e.key === "Delete" || e.key === "Backspace")) {
						e.preventDefault();
						remove(selected);
					}
				},
				{ signal },
			);

			const runDetect = async () => {
				if (busy) return;
				busy = true;
				detectBtn.disabled = true;
				status.textContent = "Looking for faces…";
				try {
					const faces = await detectFaces(base);
					if (signal.aborted) return;
					let added = 0;
					for (const f of faces) {
						const cx = f.x + f.w / 2;
						const cy = f.y + f.h / 2;
						// Skip faces that already have a sticker on them.
						const covered = stickers.some(
							(s) => Math.abs(s.cx - cx) * W < (s.size * W) / 2 && Math.abs(s.cy - cy) * H < (s.size * W) / 2,
						);
						if (covered) continue;
						const side = Math.max(f.w * W, f.h * H) * FACE_PAD;
						add(cx, cy, side / W, (currentStyle + added) % STICKERS.length);
						added++;
					}
					status.textContent =
						faces.length === 0
							? "No faces found automatically. Tap any face to cover it."
							: `Found ${faces.length} face${faces.length === 1 ? "" : "s"}. Check every face is covered, and remove stickers from performers.`;
				} catch {
					if (!signal.aborted) status.textContent = "Couldn't load the face finder. Tap each face to cover it.";
				} finally {
					busy = false;
					detectBtn.disabled = false;
				}
			};
			detectBtn.addEventListener("click", runDetect, { signal });

			const finish = (result: Blob | null) => {
				ac.abort();
				select(null);
				layer.replaceChildren();
				if (faceImg.src) URL.revokeObjectURL(faceImg.src);
				faceImg.removeAttribute("src");
				resolve(result);
			};

			$(".pe-done").addEventListener(
				"click",
				async () => {
					if (saving) return;
					saving = true;
					// Paint the stickers into the pixels so the original faces are gone.
					const out = document.createElement("canvas");
					out.width = W;
					out.height = H;
					const ctx = out.getContext("2d")!;
					if (type === "image/jpeg") {
						ctx.fillStyle = "#fff";
						ctx.fillRect(0, 0, W, H);
					}
					ctx.drawImage(base, 0, 0);
					for (const s of stickers) {
						const art = await loadSticker(s.style);
						const side = s.size * W;
						ctx.drawImage(art, s.cx * W - side / 2, s.cy * H - side / 2, side, side);
					}
					out.toBlob((blob) => finish(blob), type, 0.9);
				},
				{ signal },
			);
			onceCancelled(signal, () => finish(null));

			select(null);
			runDetect();
		});
	}

	// ---------- wiring ----------

	function showPreviews(input: HTMLInputElement, files: File[]) {
		let box = input.parentElement?.querySelector<HTMLElement>(".crop-previews");
		if (!box) {
			box = document.createElement("div");
			box.className = "crop-previews";
			input.insertAdjacentElement("afterend", box);
		}
		box.replaceChildren(
			...files.map((f) => {
				const thumb = document.createElement("img");
				thumb.alt = "";
				thumb.src = URL.createObjectURL(f);
				thumb.onload = () => URL.revokeObjectURL(thumb.src);
				return thumb;
			}),
		);
	}

	async function editPhoto(file: File, defaultRatio: string, coverFaces: boolean): Promise<File | null> {
		const base = await cropStep(file, defaultRatio, !coverFaces);
		if (!base) return null;
		// GIFs become JPEGs (first frame); PNG/WebP keep their format.
		const type = file.type === "image/png" || file.type === "image/webp" ? file.type : "image/jpeg";
		const blob = coverFaces
			? await facesStep(base, type)
			: await new Promise<Blob | null>((r) => base.toBlob(r, type, 0.9));
		if (!blob) return null;
		const ext = { "image/jpeg": "jpg", "image/png": "png", "image/webp": "webp" }[blob.type] ?? "jpg";
		const name = file.name.replace(/\.[^.]+$/, "") + "." + ext;
		return new File([blob], name, { type: blob.type, lastModified: Date.now() });
	}

	document.querySelectorAll<HTMLInputElement>('input[type="file"][data-crop]').forEach((input) => {
		input.addEventListener("change", async () => {
			const picked = Array.from(input.files ?? []);
			if (picked.length === 0) {
				showPreviews(input, []);
				return;
			}
			const result: File[] = [];
			for (const [i, file] of picked.entries()) {
				if (!EDITABLE.includes(file.type)) {
					result.push(file); // the server rejects unsupported types with a clear error
					continue;
				}
				if (!dialog.open) dialog.showModal();
				count.textContent = picked.length > 1 ? `· Photo ${i + 1} of ${picked.length}` : "";
				const edited = await editPhoto(file, input.dataset.crop || "free", !("noFaces" in input.dataset));
				if (!edited) {
					dialog.close();
					input.value = "";
					showPreviews(input, []);
					return;
				}
				result.push(edited);
			}
			if (dialog.open) dialog.close();
			// Swap the selection for the edited files; setting .files doesn't re-fire "change".
			const dt = new DataTransfer();
			result.forEach((f) => dt.items.add(f));
			input.files = dt.files;
			if ("autosubmit" in input.dataset) input.form!.requestSubmit();
			else showPreviews(input, result);
		});
	});

	// Re-edit an already-uploaded image's stickers (no crop step):
	// <button data-edit-faces="<image url>" data-target="<file input id>">. The
	// result goes into that input and its form is submitted.
	document.querySelectorAll<HTMLButtonElement>("[data-edit-faces]").forEach((btn) => {
		btn.addEventListener("click", async () => {
			const input = document.getElementById(btn.dataset.target!) as HTMLInputElement;
			btn.disabled = true;
			try {
				const res = await fetch(btn.dataset.editFaces!);
				if (!res.ok) throw new Error(`Couldn't load the photo (${res.status}).`);
				const src = await res.blob();
				const bitmap = await createImageBitmap(src);
				const base = fitCanvas(bitmap, bitmap.width, bitmap.height);
				bitmap.close();
				const type = src.type === "image/png" || src.type === "image/webp" ? src.type : "image/jpeg";
				count.textContent = "";
				dialog.showModal();
				const pending = facesStep(base, type);
				title.textContent = "Edit stickers";
				const blob = await pending;
				dialog.close();
				if (!blob) return;
				const ext = { "image/jpeg": "jpg", "image/png": "png", "image/webp": "webp" }[blob.type] ?? "jpg";
				const dt = new DataTransfer();
				dt.items.add(new File([blob], `photo.${ext}`, { type: blob.type, lastModified: Date.now() }));
				input.files = dt.files;
				input.form!.requestSubmit();
			} catch (e) {
				if (dialog.open) dialog.close();
				alert(e instanceof Error ? e.message : "Couldn't edit this photo.");
			} finally {
				btn.disabled = false;
			}
		});
	});
</script>
