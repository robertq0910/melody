---
import BaseHead from "../components/BaseHead.astro";
import PhotoEditor from "../components/PhotoEditor.astro";
import { adminEmail } from "../lib/admin";

interface Props {
	title: string;
}
const { title } = Astro.props;
const email = adminEmail(Astro.request);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Admin · ${title}`} description="Admin" />
		<meta name="robots" content="noindex" />
	</head>
	<body>
		<header class="admin-header">
			<nav>
				<a class="brand" href="/admin">Admin</a>
				<div class="links">
					<a href="/admin">Dashboard</a>
					<a href="/admin/requests">Requests</a>
					<a href="/admin/performers">Performers</a>
					<a href="/admin/performances">Performances</a>
					<a href="/" class="muted">View site →</a>
				</div>
				<span class="who muted">{email}</span>
			</nav>
		</header>
		<main>
			<slot />
		</main>
		<PhotoEditor />
		<style>
			.admin-header {
				background: rgb(var(--black));
				padding: 0.5em 1em;
			}
			.admin-header nav {
				display: flex;
				align-items: center;
				gap: 1.5em;
				flex-wrap: wrap;
				max-width: 1100px;
				margin: 0 auto;
			}
			.admin-header a {
				color: white;
				text-decoration: none;
			}
			.admin-header .brand {
				font-weight: 700;
			}
			.admin-header .links {
				display: flex;
				gap: 1.2em;
				flex-wrap: wrap;
			}
			.admin-header .who {
				margin-left: auto;
				color: rgb(var(--gray-light));
				font-size: 0.85em;
			}
			main {
				width: 1000px;
			}
			@media (max-width: 640px) {
				.admin-header {
					padding: 0.25em 0;
					position: sticky;
					top: 0;
					z-index: 10;
				}
				.admin-header nav {
					flex-wrap: nowrap;
					gap: 0;
				}
				.admin-header .brand {
					padding: 0 0.6em 0 1em;
				}
				/* One swipeable row of nav links instead of wrapping onto several lines. */
				.admin-header .links {
					flex-wrap: nowrap;
					gap: 0;
					overflow-x: auto;
					scrollbar-width: none;
					-webkit-overflow-scrolling: touch;
				}
				.admin-header .links::-webkit-scrollbar {
					display: none;
				}
				.admin-header a {
					display: flex;
					align-items: center;
					min-height: 44px;
					padding: 0 0.6em;
					white-space: nowrap;
					font-size: 0.95em;
				}
				.admin-header .who {
					display: none;
				}
				main {
					padding: 1.2em 0.75em 2em;
					max-width: calc(100% - 1.5em);
				}
			}
		</style>
	</body>
</html>
