---
import PerformanceDetail from "../../components/PerformanceDetail.astro";
import {
	getDb,
	getPerformanceBySlug,
	performersForPerformance,
	listPerformancePhotos,
	isPrelude,
} from "../../lib/db";

export const prerender = false;

const { slug } = Astro.params;
const db = getDb(Astro.locals);
const performance = slug ? await getPerformanceBySlug(db, slug) : null;

if (!performance) {
	return new Response("Not found", { status: 404 });
}
// Prelude performances live under the Prelude tab.
if (isPrelude(performance)) {
	return Astro.redirect(`/prelude/${performance.slug}`);
}

const performers = await performersForPerformance(db, performance.id);
const photos = await listPerformancePhotos(db, performance.id);
---

<PerformanceDetail
	performance={performance}
	performers={performers}
	photos={photos}
	backHref="/performances"
	backLabel="Back to all performances"
/>
