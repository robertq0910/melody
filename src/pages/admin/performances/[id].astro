---
import Admin from "../../../layouts/Admin.astro";
import { uploadImage, copyImage, deleteImage, slugify } from "../../../lib/admin";
import {
	getDb,
	getPerformanceById,
	performerIdsForPerformance,
	listPerformancePhotos,
	uniquePerformanceSlug,
} from "../../../lib/db";
import { mediaUrl } from "../../../lib/media";

export const prerender = false;

const db = getDb(Astro.locals);
const bucket = Astro.locals.runtime?.env?.MEDIA;
const id = parseInt(Astro.params.id ?? "", 10);

let error: string | null = null;

if (Number.isFinite(id) && Astro.request.method === "POST") {
	const form = await Astro.request.formData();
	const action = String(form.get("action"));
	try {
		const existing = await getPerformanceById(db, id);
		if (!existing) throw new Error("Performance not found.");

		if (action === "update") {
			const title = String(form.get("title") ?? "").trim();
			if (!title) throw new Error("Title is required.");

			let coverKey = existing.cover_key;
			const newCover = await uploadImage(bucket, form.get("cover"), "performances");
			if (newCover) {
				await deleteImage(bucket, existing.cover_key);
				coverKey = newCover;
			} else if (form.get("remove_cover")) {
				await deleteImage(bucket, existing.cover_key);
				coverKey = null;
			}

			await db
				.prepare(
					`UPDATE performances
					 SET title = ?, slug = ?, venue = ?, location = ?, event_date = ?,
					     summary = ?, description = ?, cover_key = ?, published = ?
					 WHERE id = ?`,
				)
				.bind(
					title,
					await uniquePerformanceSlug(db, slugify(title) || existing.slug, id),
					String(form.get("venue") ?? "").trim() || null,
					String(form.get("location") ?? "").trim() || null,
					String(form.get("event_date") ?? "").trim() || null,
					String(form.get("summary") ?? "").trim() || null,
					String(form.get("description") ?? "").trim() || null,
					coverKey,
					form.get("published") ? 1 : 0,
					id,
				)
				.run();

			// Reset and re-link performers. Checkboxes arrive in their (dragged) on-page
			// order, which becomes the line-up order.
			await db.prepare("DELETE FROM performance_performers WHERE performance_id = ?").bind(id).run();
			const performerIds = form.getAll("performers").map((v) => parseInt(String(v), 10));
			for (const [i, pid] of performerIds.entries()) {
				if (Number.isFinite(pid)) {
					await db
						.prepare(
							"INSERT OR IGNORE INTO performance_performers (performance_id, performer_id, sort_order) VALUES (?, ?, ?)",
						)
						.bind(id, pid, i)
						.run();
				}
			}
		} else if (action === "clone") {
			// Copy everything except the cover and gallery photos, as a hidden draft.
			const title = `${existing.title} (copy)`;
			const res = await db
				.prepare(
					`INSERT INTO performances
					 (title, slug, venue, location, event_date, summary, description, cover_key, published)
					 VALUES (?, ?, ?, ?, ?, ?, ?, NULL, 0)`,
				)
				.bind(
					title,
					await uniquePerformanceSlug(db, slugify(title) || "performance"),
					existing.venue,
					existing.location,
					existing.event_date,
					existing.summary,
					existing.description,
				)
				.run();
			const cloneId = res.meta.last_row_id;
			await db
				.prepare(
					`INSERT INTO performance_performers (performance_id, performer_id, sort_order)
					 SELECT ?, performer_id, sort_order FROM performance_performers WHERE performance_id = ?`,
				)
				.bind(cloneId, id)
				.run();
			return Astro.redirect(`/admin/performances/${cloneId}?cloned=1`);
		} else if (action === "add_photo") {
			const files = form.getAll("photo").filter((f) => f instanceof File && f.size > 0);
			if (files.length === 0) throw new Error("Choose at least one image to upload.");
			const caption = String(form.get("caption") ?? "").trim() || null;
			const startOrder = parseInt(String(form.get("sort_order") ?? "0"), 10) || 0;
			// Upload in selection order; photos already saved stay saved if a later one fails.
			for (const [i, file] of files.entries()) {
				let photoKey: string | null;
				try {
					photoKey = await uploadImage(bucket, file, "gallery");
				} catch (e) {
					const msg = e instanceof Error ? e.message : "Upload failed.";
					throw new Error(`Uploaded ${i} of ${files.length}. "${(file as File).name}": ${msg}`);
				}
				if (!photoKey) continue;
				await db
					.prepare(
						"INSERT INTO performance_photos (performance_id, photo_key, caption, sort_order) VALUES (?, ?, ?, ?)",
					)
					.bind(id, photoKey, caption, startOrder + i)
					.run();
			}
		} else if (action === "set_cover") {
			const photoId = parseInt(String(form.get("photo_id")), 10);
			const photo = await db
				.prepare("SELECT photo_key FROM performance_photos WHERE id = ? AND performance_id = ?")
				.bind(photoId, id)
				.first<{ photo_key: string }>();
			if (!photo) throw new Error("Photo not found.");
			// Copy rather than share the key, so the cover and gallery photo can be
			// replaced/deleted independently.
			const coverKey = await copyImage(bucket, photo.photo_key, "performances");
			await db.prepare("UPDATE performances SET cover_key = ? WHERE id = ?").bind(coverKey, id).run();
			await deleteImage(bucket, existing.cover_key);
			return Astro.redirect(`/admin/performances/${id}?cover=1`);
		} else if (action === "replace_photo") {
			// Sent by the Edit (re-stickered) and Replace (new picture) buttons.
			const photoId = parseInt(String(form.get("photo_id")), 10);
			const photo = await db
				.prepare("SELECT photo_key FROM performance_photos WHERE id = ? AND performance_id = ?")
				.bind(photoId, id)
				.first<{ photo_key: string }>();
			if (!photo) throw new Error("Photo not found.");
			const newKey = await uploadImage(bucket, form.get("photo"), "gallery");
			if (!newKey) throw new Error("No edited image was received.");
			await db.prepare("UPDATE performance_photos SET photo_key = ? WHERE id = ?").bind(newKey, photoId).run();
			await deleteImage(bucket, photo.photo_key);
		} else if (action === "reorder_photos") {
			// Sent by the drag-to-reorder script as the full list of photo ids in display order.
			const ids = String(form.get("order") ?? "")
				.split(",")
				.map((v) => parseInt(v, 10))
				.filter(Number.isFinite);
			if (ids.length > 0) {
				await db.batch(
					ids.map((photoId, i) =>
						db
							.prepare("UPDATE performance_photos SET sort_order = ? WHERE id = ? AND performance_id = ?")
							.bind(i, photoId, id),
					),
				);
			}
			return new Response(null, { status: 204 });
		} else if (action === "delete_photo") {
			const photoId = parseInt(String(form.get("photo_id")), 10);
			const photo = await db
				.prepare("SELECT photo_key FROM performance_photos WHERE id = ? AND performance_id = ?")
				.bind(photoId, id)
				.first<{ photo_key: string }>();
			if (photo) {
				await deleteImage(bucket, photo.photo_key);
				await db.prepare("DELETE FROM performance_photos WHERE id = ?").bind(photoId).run();
			}
		}
		return Astro.redirect(`/admin/performances/${id}`);
	} catch (e) {
		error = e instanceof Error ? e.message : "Something went wrong.";
	}
}

const performance = Number.isFinite(id) ? await getPerformanceById(db, id) : null;
if (!performance) {
	return new Response("Performance not found", { status: 404 });
}

const linkedOrder = await performerIdsForPerformance(db, id);
const linkedIds = new Set(linkedOrder);
const photos = await listPerformancePhotos(db, id);
// New uploads go after the existing photos by default.
const nextSortOrder = photos.reduce((max, p) => Math.max(max, p.sort_order + 1), 0);
const { results: allPerformers } = await db
	.prepare("SELECT id, name FROM performers ORDER BY sort_order, name")
	.all<{ id: number; name: string }>();
// Line-up first (in its saved order), then everyone else in the global order.
const performerChoices = [
	...linkedOrder.flatMap((pid) => allPerformers.filter((p) => p.id === pid)),
	...allPerformers.filter((p) => !linkedIds.has(p.id)),
];
---

<Admin title={`Edit ${performance.title}`}>
	<p><a href="/admin/performances">← Back to performances</a></p>
	<div class="title-row">
		<h1>Edit performance</h1>
		<form method="POST">
			<input type="hidden" name="action" value="clone" />
			<button
				class="btn btn-secondary"
				type="submit"
				title="Make a new performance with the same details (no pictures)"
			>
				Clone
			</button>
		</form>
	</div>
	{
		Astro.url.searchParams.has("cloned") && (
			<div class="notice notice-success">
				This is a new copy (without pictures). It's hidden from the site until you check
				“Visible on site” and save.
			</div>
		)
	}
	{
		Astro.url.searchParams.has("cover") && (
			<div class="notice notice-success">Cover updated from the gallery.</div>
		)
	}
	{error && <div class="notice notice-error">{error}</div>}

	<div class="cols">
		<form method="POST" enctype="multipart/form-data" class="edit-form">
			<input type="hidden" name="action" value="update" />
			<div class="field">
				<label for="title">Title *</label>
				<input id="title" name="title" required value={performance.title} />
			</div>
			<div class="row">
				<div class="field">
					<label for="venue">Venue</label>
					<input id="venue" name="venue" value={performance.venue ?? ""} />
				</div>
				<div class="field">
					<label for="location">Location</label>
					<input id="location" name="location" value={performance.location ?? ""} />
				</div>
			</div>
			<div class="field">
				<label for="event_date">Date</label>
				<input id="event_date" name="event_date" type="date" value={performance.event_date ?? ""} />
			</div>
			<div class="field">
				<label for="summary">Summary</label>
				<input id="summary" name="summary" value={performance.summary ?? ""} />
			</div>
			<div class="field">
				<label for="description">Description</label>
				<textarea id="description" name="description" rows="5">{performance.description ?? ""}</textarea>
			</div>
			<div class="field">
				<label>Current cover</label>
				{
					performance.cover_key ? (
						<div class="current">
							<img src={mediaUrl(performance.cover_key)} alt="" />
							<label class="inline">
								<input type="checkbox" name="remove_cover" /> Remove cover
							</label>
						</div>
					) : (
						<p class="muted">No cover.</p>
					)
				}
			</div>
			<div class="field">
				<label for="cover">Replace cover</label>
				<input id="cover" name="cover" type="file" accept="image/*" data-crop="3/2" />
			</div>
			<div class="field">
				<label>Performers</label>
				<ul class="lineup" data-lineup>
					{
						performerChoices.map((p) => (
							<li>
								<button class="lineup-handle" type="button" aria-label={`Reorder ${p.name}`}>
									⠿
								</button>
								<label class="inline">
									<input type="checkbox" name="performers" value={p.id} checked={linkedIds.has(p.id)} />{" "}
									{p.name}
								</label>
							</li>
						))
					}
				</ul>
				<span class="hint">
					Tick who played. Drag ⠿ (or use the arrow keys on it) to set the order shown on the site,
					then Save changes.
				</span>
			</div>
			<div class="field">
				<label class="inline">
					<input type="checkbox" name="published" checked={performance.published === 1} /> Visible on
					site
				</label>
			</div>
			<button class="btn btn-primary" type="submit">Save changes</button>
		</form>

		<aside class="gallery-admin">
			<h2>Photo gallery</h2>
			{
				photos.length > 1 && (
					<p class="muted reorder-hint">
						Drag the ⠿ handle (or a photo, with a mouse) to change the order.{" "}
						<span class="reorder-status" aria-live="polite" />
					</p>
				)
			}
			<div class="gallery" data-reorder>
				{
					photos.map((photo) => (
						<div class="g-item" data-photo-id={photo.id}>
							<div class="g-thumb">
								<img src={mediaUrl(photo.photo_key)} alt={photo.caption ?? ""} draggable="false" />
								{photos.length > 1 && (
									<button
										class="g-handle"
										type="button"
										title="Drag to reorder (or use the arrow keys)"
										aria-label="Reorder photo"
									>
										⠿
									</button>
								)}
							</div>
							{photo.caption && <span class="cap">{photo.caption}</span>}
							<div class="g-actions">
								<button
									class="link-btn"
									type="button"
									data-edit-faces={mediaUrl(photo.photo_key)}
									data-target={`edit-photo-${photo.id}`}
									title="Add or move cartoon stickers on this photo"
								>
									Edit
								</button>
								<button
									class="link-btn"
									type="button"
									onclick={`document.getElementById('edit-photo-${photo.id}').click()`}
									title="Swap in a different picture"
								>
									Replace
								</button>
								<form method="POST" enctype="multipart/form-data" hidden>
									<input type="hidden" name="action" value="replace_photo" />
									<input type="hidden" name="photo_id" value={photo.id} />
									<input
										id={`edit-photo-${photo.id}`}
										name="photo"
										type="file"
										accept="image/*"
										data-crop="free"
										data-autosubmit
									/>
								</form>
								<form
									method="POST"
									onsubmit="return confirm('Use this photo as the cover? It replaces the current cover.')"
								>
									<input type="hidden" name="action" value="set_cover" />
									<input type="hidden" name="photo_id" value={photo.id} />
									<button class="link-btn" type="submit">Make cover</button>
								</form>
								<form method="POST" onsubmit="return confirm('Delete this photo?')">
									<input type="hidden" name="action" value="delete_photo" />
									<input type="hidden" name="photo_id" value={photo.id} />
									<button class="link-btn danger" type="submit">Delete</button>
								</form>
							</div>
						</div>
					))
				}
			</div>
			{photos.length === 0 && <p class="muted">No gallery photos yet.</p>}

			<form method="POST" enctype="multipart/form-data" class="add-photo">
				<input type="hidden" name="action" value="add_photo" />
				<div class="field">
					<label for="photo">Add photos</label>
					<input id="photo" name="photo" type="file" accept="image/*" multiple required data-crop="free" />
					<small class="muted">Select several at once. Each must be under 5 MB.</small>
				</div>
				<div class="field">
					<label for="caption">Caption</label>
					<input id="caption" name="caption" />
					<small class="muted">Applied to every photo in this upload. Leave blank for none.</small>
				</div>
				<div class="field">
					<label for="sort_order">Sort order</label>
					<input id="sort_order" name="sort_order" type="number" value={nextSortOrder} />
					<small class="muted">Photos in one upload are numbered up from this, in the order selected.</small>
				</div>
				<button class="btn btn-secondary" type="submit">Upload photos</button>
			</form>
		</aside>
	</div>
</Admin>

<script>
	import { makeSortable, saveOrder } from "../../../scripts/sortable";

	// Gallery order is saved as soon as a drag ends.
	const gallery = document.querySelector<HTMLElement>("[data-reorder]");
	const status = document.querySelector<HTMLElement>(".reorder-status");
	if (gallery && gallery.querySelector(".g-handle")) {
		makeSortable(gallery, {
			items: ".g-item",
			handle: ".g-handle",
			mouseArea: ".g-thumb img",
			onChange: (items) =>
				saveOrder(
					"reorder_photos",
					items.map((el) => el.dataset.photoId!),
					status,
				),
		});
	}

	// Line-up order is just the checkbox order, submitted with "Save changes".
	const lineup = document.querySelector<HTMLElement>("[data-lineup]");
	if (lineup) makeSortable(lineup, { items: "li", handle: ".lineup-handle", onChange: () => {} });
</script>

<style>
	.title-row {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.6em 1em;
	}
	.title-row h1 {
		margin: 0;
	}
	.cols {
		display: grid;
		grid-template-columns: 1fr 320px;
		gap: 2em;
		align-items: start;
	}
	.current img {
		width: 160px;
		aspect-ratio: 3 / 2;
		object-fit: cover;
		border-radius: 8px;
		display: block;
		margin-bottom: 0.4em;
	}
	.inline {
		display: inline-flex !important;
		align-items: center;
		gap: 0.4em;
		font-weight: 400 !important;
	}
	.gallery-admin {
		background: white;
		border-radius: 12px;
		padding: 1.2em;
		box-shadow: 0 2px 8px rgba(var(--gray), 18%);
	}
	.gallery-admin h2 {
		margin-top: 0;
		font-size: 1.3em;
	}
	.gallery {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 0.8em;
		margin-bottom: 1em;
	}
	.lineup {
		list-style: none;
		margin: 0;
		padding: 0.3em;
		max-height: 320px;
		overflow-y: auto;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 8px;
		background: white;
	}
	.lineup li {
		display: flex;
		align-items: center;
		gap: 0.5em;
		padding: 0.2em 0.3em;
		border-radius: 6px;
	}
	.lineup li.dragging {
		opacity: 0.5;
		background: rgb(var(--gray-light));
	}
	.lineup li.dragging,
	.lineup li.dragging * {
		cursor: grabbing;
	}
	.lineup-handle {
		flex: none;
		width: 30px;
		height: 30px;
		border: none;
		border-radius: 6px;
		background: rgb(var(--gray-light));
		color: rgb(var(--gray-dark));
		line-height: 1;
		cursor: grab;
		touch-action: none;
	}
	.g-thumb {
		position: relative;
	}
	.g-thumb img {
		cursor: grab;
	}
	.g-handle {
		position: absolute;
		top: 4px;
		left: 4px;
		width: 32px;
		height: 32px;
		border: none;
		border-radius: 6px;
		background: rgba(0, 0, 0, 0.55);
		color: white;
		font-size: 1.1em;
		line-height: 1;
		cursor: grab;
		touch-action: none;
	}
	.g-item.dragging {
		opacity: 0.5;
	}
	.g-item.dragging,
	.g-item.dragging * {
		cursor: grabbing;
	}
	.reorder-hint {
		font-size: 0.85em;
		margin-top: -0.4em;
	}
	.g-item img {
		width: 100%;
		aspect-ratio: 1;
		object-fit: cover;
		border-radius: 8px;
	}
	.g-item .cap {
		font-size: 0.8em;
		color: rgb(var(--gray));
		display: block;
	}
	.g-actions {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 0 0.6em;
	}
	.link-btn {
		background: none;
		border: none;
		color: var(--accent);
		cursor: pointer;
		padding: 0;
		font-size: 0.85em;
	}
	.link-btn.danger {
		color: #9b1c1c;
	}
	.add-photo {
		border-top: 1px solid rgb(var(--gray-light));
		padding-top: 1em;
	}
	@media (max-width: 820px) {
		.cols {
			grid-template-columns: 1fr;
		}
	}
	@media (max-width: 640px) {
		.gallery-admin {
			padding: 1em;
		}
		.link-btn {
			min-height: 44px;
			font-size: 0.95em;
		}
	}
</style>
